{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aspice/process-audit-result.schema.json",
  "title": "ASPICE Process Audit Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_id", "agent_version", "run_id", "project_id", "process_id", "scope_status", "checks", "summary"],
  "properties": {
    "agent_id": {"type": "string"},
    "agent_version": {"type": "string"},
    "run_id": {"type": "string"},
    "project_id": {"type": "string"},
    "release_or_baseline": {"type": ["string", "null"]},
    "process_id": {"type": "string"},
    "scope_status": {"type": "string", "enum": ["in_scope", "conditional", "not_in_scope", "out_of_scope", "unknown"]},
    "assessment_mode": {"type": "string", "const": "evidence_inventory_only"},
    "captured_at": {"type": "string"},
    "snapshot": {"type": "object", "additionalProperties": true},
    "evidence_objects": {"type": "array", "items": {"$ref": "evidence_object.schema.json"}},
    "evidence_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "name", "outcomes", "discovery_status", "review_status", "artifact_ids", "candidate_paths", "rationale"],
        "properties": {
          "item_id": {"type": "string"},
          "name": {"type": "string"},
          "outcomes": {"type": "array", "items": {"type": "string"}},
          "discovery_status": {"type": "string", "enum": ["evidence_present", "missing"]},
          "review_status": {"type": "string", "enum": ["needs_human_review", "missing"]},
          "artifact_ids": {"type": "array", "items": {"type": "string"}},
          "candidate_paths": {"type": "array", "items": {"type": "string"}},
          "rationale": {"type": "string"}
        }
      }
    },
    "checks": {"type": "array", "items": {"$ref": "audit-finding.schema.json"}},
    "cross_domain_issues": {"type": "array", "items": {"type": "string"}},
    "questions_for_owner": {"type": "array", "items": {"type": "string"}},
    "human_review_queue": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "reason", "required_action", "related_artifact_ids"],
        "properties": {
          "gate": {"type": "string"},
          "reason": {"type": "string"},
          "required_action": {"type": "string"},
          "related_artifact_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "evidence_status_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_present", "missing", "needs_human_review"],
      "properties": {
        "evidence_present": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "needs_human_review": {"type": "integer", "minimum": 0}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["satisfied", "partial", "gap", "unknown", "conflict", "not_in_scope"],
      "properties": {
        "satisfied": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0},
        "gap": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0},
        "conflict": {"type": "integer", "minimum": 0},
        "not_in_scope": {"type": "integer", "minimum": 0}
      }
    }
  }
}
