{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aspice/manager-work-package.schema.json",
  "title": "ASPICE Manager Work Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_id", "agent_version", "run_id", "project_id", "domain_scope", "responsibility_map", "work_packages", "decisions_requiring_human_confirmation"],
  "properties": {
    "agent_id": {"type": "string"},
    "agent_version": {"type": "string"},
    "run_id": {"type": "string"},
    "project_id": {"type": "string"},
    "release_or_baseline": {"type": ["string", "null"]},
    "domain_scope": {"type": "string"},
    "responsibility_map": {"type": "array", "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "process_ids", "spec_citations", "accountable_owner", "evidence_owner", "independent_verification_owner", "qa_reviewer", "affected_parties", "independence_risk"],
      "properties": {
        "finding_id": {"type": "string"},
        "process_ids": {"type": "array", "items": {"type": "string"}},
        "spec_citations": {"type": "array", "minItems": 1, "items": {"$ref": "direct-spec-citation.schema.json"}},
        "accountable_owner": {"type": "string"},
        "evidence_owner": {"type": "string"},
        "independent_verification_owner": {"type": "string"},
        "qa_reviewer": {"type": "string"},
        "affected_parties": {"type": "array", "items": {"type": "string"}},
        "independence_risk": {"type": "string", "enum": ["none", "possible", "confirmed", "unknown"]}
      }
    }},
    "work_packages": {"type": "array", "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "finding_ids", "spec_citations", "objective", "required_artifacts", "owner", "reviewer", "due_date", "dependencies", "completion_criteria", "reverification_plan", "closure_authority", "status"],
      "properties": {
        "action_id": {"type": "string"},
        "finding_ids": {"type": "array", "items": {"type": "string"}},
        "spec_citations": {"type": "array", "minItems": 1, "items": {"$ref": "direct-spec-citation.schema.json"}},
        "objective": {"type": "string"},
        "required_artifacts": {"type": "array", "items": {"type": "string"}},
        "owner": {"type": "string"},
        "reviewer": {"type": "string"},
        "due_date": {"type": "string"},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "completion_criteria": {"type": "array", "items": {"type": "string"}},
        "reverification_plan": {"type": "string"},
        "closure_authority": {"type": "string", "enum": ["process_owner", "verification_owner", "qa", "lead_assessor", "unknown"]},
        "status": {"type": "string", "enum": ["proposed", "approved", "in_progress", "blocked", "ready_for_reverification", "closed"]}
      }
    }},
    "interface_risks": {"type": "array", "items": {"type": "string"}},
    "escalations": {"type": "array", "items": {"type": "string"}},
    "resource_requests": {"type": "array", "items": {"type": "string"}},
    "decisions_requiring_human_confirmation": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string"}
  }
}
